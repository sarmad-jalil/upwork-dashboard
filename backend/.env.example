# Copy this file to .env and fill in your keys

# Anthropic (Claude) — paid subscription
ANTHROPIC_API_KEY=your_anthropic_key_here

# Mistral AI — paid but has free tier
MISTRAL_API_KEY=your_mistral_key_here

# Groq — free tier available
GROQ_API_KEY=your_groq_key_here

# Apify — powers the Jobs scraping tab (hyperbach/upwork-scraper-ai actor)
APIFY_TOKEN=your_apify_token_here

# Supabase Postgres — Project Settings → Database → Connection string → URI
# (all storage — profiles and scraped jobs — lives here, not in a local file)
DATABASE_URL=postgresql://postgres.xxxxx:your_password@aws-0-region.pooler.supabase.com:6543/postgres
